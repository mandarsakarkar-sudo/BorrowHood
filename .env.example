# Change both secrets before any shared deployment.
BORROWHOOD_SECRET=replace-with-a-long-random-session-secret
BORROWHOOD_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Optional: set to 1 when served over HTTPS.
BORROWHOOD_SECURE_COOKIE=0
# Optional database path. Default is ./borrowhood.db
# BORROWHOOD_DB=./borrowhood.db
